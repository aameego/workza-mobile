# local | development | production
# Native login and the in-app WebView must share this environment:
#   development → API https://dev-gig.aameego.com/api, site https://dev.workza.ai
#   production  → API https://backend-gig.aameego.com/api, site https://workza.ai
#                 (only npm run android:production / an explicit EXPO_PUBLIC_API_ENV=production)
#   local       → API http://localhost:5001/api, site http://localhost:3000
# Missing or unknown names also resolve to development — never silently to production.
EXPO_PUBLIC_API_ENV=development

# Optional full overrides
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5001/api
# EXPO_PUBLIC_WEB_APP_URL=https://dev.workza.ai

# Must match WORKZA_MOBILE_CLIENT_KEY on the backend. The 1.0.4 sideload APK
# does not send this, so production can reject it while the website still works.
# EXPO_PUBLIC_MOBILE_CLIENT_KEY=

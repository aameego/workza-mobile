# local | development | production
# Native login and the in-app WebView must share this environment:
#   development → API https://dev-gig.aameego.com/api, site https://dev.workza.ai
#   production  → API https://backend-gig.aameego.com/api, site https://workza.ai
#   local       → API http://localhost:5001/api, site http://localhost:3000
EXPO_PUBLIC_API_ENV=development

